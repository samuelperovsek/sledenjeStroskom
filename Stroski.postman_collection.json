{
  "info": {
    "name": "Stroski - CRUD",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "base", "value": "http://localhost:8080/api/expenses" }],
  "item": [
    {
      "name": "Create",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base}}",
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Kosilo\",\n  \"amount\": 6.50,\n  \"category\": \"Hrana\",\n  \"date\": \"2026-10-07\",\n  \"note\": \"Študentska prehrana\"\n}" }
      }
    },
    { "name": "Read all", "request": { "method": "GET", "url": "{{base}}" } },
    { "name": "Read one", "request": { "method": "GET", "url": "{{base}}/1" } },
    {
      "name": "Update",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{base}}/1",
        "body": { "mode": "raw", "raw": "{\n  \"title\": \"Kosilo + kava\",\n  \"amount\": 8.00,\n  \"category\": \"Hrana\",\n  \"date\": \"2026-10-07\",\n  \"note\": \"Posodobljeno\"\n}" }
      }
    },
    { "name": "Delete", "request": { "method": "DELETE", "url": "{{base}}/1" } }
  ]
}
